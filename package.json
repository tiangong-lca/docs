{
  "name": "tiangong-lca-next-docs",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "verify:out": "node scripts/verify-out.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:screenshots": "node scripts/check-screenshots.mjs",
    "test": "node --test scripts/check-env.test.mjs scripts/seo-policy.test.mjs scripts/check-links.test.mjs scripts/oauth-doc-contract.test.mjs scripts/tool-guides.test.mjs scripts/public-doc-inventory.test.mjs scripts/toolchain-contract.test.mjs scripts/context7-refresh.test.mjs scripts/locale-preference.test.mjs scripts/dependency-consumers.test.mjs",
    "test:env": "node --test scripts/check-env.test.mjs",
    "test:links": "node --test scripts/check-links.test.mjs",
    "test:screenshots": "node --test scripts/check-screenshots.test.mjs",
    "test:toolchain": "node --test scripts/toolchain-contract.test.mjs",
    "lint": "pnpm exec markdownlint-cli2 '**/*.md' '**/*.mdx' '#node_modules' '#content/docs/.source'"
  },
  "dependencies": {
    "@fumadocs/language": "0.2.17",
    "algoliasearch": "5.61.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.9",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "markdownlint-cli2": "0.24.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
